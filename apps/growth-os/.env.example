# ---- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by webhooks, cron and usage logging. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
# Random 32+ char string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ---- Paystack (required for paid plans) ---------------------------------------
PAYSTACK_SECRET_KEY=
# Optional: map plan codes to Paystack plan codes in the admin panel for auto-renewal

# ---- AI (optional — assistant shows "not configured" without it) --------------
ANTHROPIC_API_KEY=

# ---- Email via Resend (optional — product emails are skipped without it) ------
RESEND_API_KEY=
EMAIL_FROM="Growth OS <hello@yourdomain.com>"

# ---- Analytics (optional) -----------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
